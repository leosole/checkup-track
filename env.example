# Copy these into a `.env.local` file at the repo root (the backend loads it
# automatically at startup) or export them in your shell.
# Backend keys consumed by FastAPI:

# Set to 1 on Render so FastAPI also serves the built SPA from frontend/dist.
# Leave unset for local development, where Vite serves the frontend.
SERVE_STATIC=

# Stable high-entropy secret used to encrypt user-supplied LLM keys at rest.
# Do not change after credentials have been saved or they cannot be decrypted.
# Render generates this automatically; locally use a random value of 32+ bytes.
CREDENTIAL_ENCRYPTION_KEY=

# Postgres connection string. When unset, the backend uses SQLite at
# backend/health.db (fine for local dev; data is ephemeral on hosted filesystems).
# Production uses Aiven for PostgreSQL. Copy the "Service URI" from the Aiven
# console (Overview -> Connection information), which looks like:
# postgresql://avnadmin:PASSWORD@pg-<service>-<project>.aivencloud.com:<port>/defaultdb?sslmode=require
#
# scripts/migrate_database.py copies data between two databases and reads its
# URLs from here when --from/--to are not given. Set MIGRATE_FROM_DATABASE_URL
# to the old (Neon) URI while migrating, then remove it; the script's target
# defaults to DATABASE_URL below.
# postgresql://avnadmin:PASSWORD@pg-<service>-<project>.aivencloud.com:<port>/defaultdb?sslmode=require
# Aiven requires TLS, so keep sslmode=require. URL-encode any @ : / or # in the
# password (e.g. @ -> %40). Do not point production at a Neon database.
DATABASE_URL=

# Old database to copy FROM when running scripts/migrate_database.py
# (source). Not read by the app. The script also accepts OLD_DATABASE_URL as a
# fallback name. Remove this after the migration.
MIGRATE_FROM_DATABASE_URL=
OLD_DATABASE_URL=

# Optional override for the script's target; defaults to DATABASE_URL.
MIGRATE_TO_DATABASE_URL=

# Google OAuth 2.0 Web client ID used to verify ID tokens
GOOGLE_CLIENT_ID=

# Enable the public synthetic account and the "Login as test user" option.
# Visitors share saved metadata/medication edits. Set to 0 to disable access.
TEST_USER_ENABLED=1

# Secret used to sign local JWT access tokens (auto-generated dev secret when unset)
JWT_SECRET=

# Backblaze B2 (optional in dev): when all three are set, lab-report PDFs go to
# the bucket instead of backend/storage/pdfs/ (free 10 GB tier, no credit card).
# Keys: B2 account -> Application Keys -> add key with Write access to the bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
