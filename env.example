# Copy these into a `.env.local` file at the repo root (the backend loads it
# automatically at startup) or export them in your shell.
# Backend keys consumed by FastAPI:

# Set to 1 on Render so FastAPI also serves the built SPA from frontend/dist.
# Leave unset for local development, where Vite serves the frontend.
SERVE_STATIC=

# Gemini API key for structured biomarker extraction
# (https://aistudio.google.com/apikey). Tried first when set; its free tier
# accepts a whole report in one request, where Groq's free plan caps a model at
# 8000 tokens/minute. The free tier may use prompts to improve Google's
# products - use the paid tier for records you would not share.
GEMINI_API_KEY=

# Optional Gemini model override (default: gemini-3.8-flash). Pick a current
# Flash model in AI Studio if the default is ever retired.
GEMINI_MODEL=

# Groq API key, used as the extraction fallback (https://console.groq.com/keys)
GROQ_API_KEY=

# Postgres connection string. When unset, the backend uses SQLite at
# backend/health.db (fine for local dev; data is ephemeral on hosted filesystems).
# Neon free tier works: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Google OAuth 2.0 Web client ID used to verify ID tokens
GOOGLE_CLIENT_ID=

# Secret used to sign local JWT access tokens (auto-generated dev secret when unset)
JWT_SECRET=

# Backblaze B2 (optional in dev): when all three are set, lab-report PDFs go to
# the bucket instead of backend/storage/pdfs/ (free 10 GB tier, no credit card).
# Keys: B2 account -> Application Keys -> add key with Write access to the bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
