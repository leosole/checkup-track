# Copy these into your environment (or workspace Settings -> Environment).
# Backend keys consumed by FastAPI:

# Groq API key for structured biomarker extraction (https://console.groq.com/keys)
GROQ_API_KEY=

# Postgres connection string. When unset, the backend uses SQLite at
# backend/health.db (fine for local dev; data is ephemeral on hosted filesystems).
# Neon free tier works: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Google OAuth 2.0 Web client ID used to verify ID tokens
GOOGLE_CLIENT_ID=

# Secret used to sign local JWT access tokens (auto-generated dev secret when unset)
JWT_SECRET=

# Backblaze B2 (optional in dev): when all three are set, lab-report PDFs go to
# the bucket instead of backend/storage/pdfs/ (free 10 GB tier, no credit card).
# Keys: B2 account -> Application Keys -> add key with Write access to the bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
